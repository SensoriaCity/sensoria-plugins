{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--isolated",
        "--ignore-https-errors",
        "--no-webmcp",
        "--output-dir",
        "${TMPDIR:-/tmp}/city-playwright-s${CITY_SLOT:-0}"
      ]
    }
  }
}
